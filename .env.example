# ==============================================================================
# MCP Multivendor Tutorial - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Basic MCP Server (examples/01 and 02) -----------------------------------

MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_TRANSPORT=streamable-http
# Options: streamable-http, stdio

# --- Red Hat MCP Server Connection (examples/03) -----------------------------

# Red Hat SSO / OAuth2 credentials
# Register at: https://sso.redhat.com
RH_SSO_TOKEN_URL=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
RH_SSO_CLIENT_ID=your-client-id
RH_SSO_CLIENT_SECRET=your-client-secret

# Red Hat MCP server endpoint
# See: https://catalog.redhat.com (search "MCP server")
RH_MCP_SERVER_URL=https://your-mcp-server-endpoint.redhat.com/mcp

# --- mTLS Configuration (security/) ------------------------------------------

# Paths to your certificate files (generated by security/generate_certs.sh)
MTLS_CA_CERT=./certs/ca.crt
MTLS_CLIENT_CERT=./certs/client.crt
MTLS_CLIENT_KEY=./certs/client.key

# For server-side (if running your own MCP server with mTLS)
MTLS_SERVER_CERT=./certs/server.crt
MTLS_SERVER_KEY=./certs/server.key

# --- Optional: VPN / Network -------------------------------------------------

# If the MCP server requires VPN or IP allowlisting
# VPN_GATEWAY=vpn.example.com
# ALLOWED_CLIENT_IPS=10.0.0.0/8

# --- RCA Orchestrator (docs/multivendor_rca_pattern.md) ----------------------

# Policy-enforcing gateway all cross-vendor tool calls pass through
MCP_GATEWAY_URL=https://your-mcp-gateway.example.com
MCP_GATEWAY_API_KEY=your-gateway-api-key

# One MCP server per evidence plane (roles, not brands)
RCA_PLANE_RAN_URL=https://ran-agent.example.com/mcp
RCA_PLANE_PLATFORM_URL=https://platform-agent.example.com/mcp
RCA_PLANE_FORENSICS_URL=https://forensics-agent.example.com/mcp
RCA_PLANE_HARDWARE_URL=https://hardware-agent.example.com/mcp

# Independent planes that must agree before the orchestrator concludes;
# below this bar it emits HOLD and defers to a human
RCA_CORROBORATION_MIN=2

# Orchestrator endpoint for the incident-capture script (scripts/capture_incident.py)
RCA_ORCHESTRATOR_URL=https://rca-orchestrator.example.com
RCA_ORCH_PREFIX=/nep
